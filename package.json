{
	"name": "note-lang",
	"displayName": "Note Lang",
	"description": "Extension for writing notes more efficiently with syntax highlighting and text formatting",
	"icon": "icon.png",
	"version": "1.3.0",
	"publisher": "sagittarius-9",
	"author": "Sagittarius_9",
	"license": "SEE LICENSE IN LICENSE",
	"engines": {
		"vscode": "^1.75.0"
	},

	"categories": [
		"Programming Languages",
		"Snippets"
	],

	"keywords": [
		"note",
		"notes",
		"cours",
		"prise de notes",
		"notation"
	],

	"main": "./extension.js",

	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},

	"contributes": {
		"commands": [
			{ "command": "noteLang.generateClassConstructor", "title": "Note Lang: Générer classe + constructeur depuis une liste d'attributs" },
			{ "command": "noteLang.exportMarkdown", "title": "Note Lang: Exporter en Markdown" },
   			{ "command": "noteLang.exportPdf", "title": "Note Lang: Exporter en PDF" }

		],
		"menus": {
			"editor/context": [
				{ "command": "noteLang.exportMarkdown", "when": "editorLangId == note", "group": "export@1" },
				{ "command": "noteLang.exportPdf", "when": "editorLangId == note", "group": "export@2" }
			],
			"explorer/context": [
				{ "command": "noteLang.exportMarkdown", "when": "resourceLangId == note", "group": "export@1" },
				{ "command": "noteLang.exportPdf", "when": "resourceLangId == note", "group": "export@2" }
			],
			"commandPalette": [
				{ "command": "noteLang.exportMarkdown", "when": "editorLangId == note" },
				{ "command": "noteLang.exportPdf", "when": "editorLangId == note" }
			]
		},
		"configurationDefaults": {
			"[note]": {
				"editor.guides.bracketPairs": true,
				"editor.guides.bracketPairsHorizontal": false,
				"editor.guides.indentation": true
			}
		},
		"languages": [
			{
				"id": "note",
				"aliases": [ "Note", "note", "cours" ],
				"extensions": [ ".note", ".cours"],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "note",
				"scopeName": "source.note",
				"path": "./syntaxes/note.tmLanguage.json",
				"unbalancedBracketScopes": ["meta.quoted.string.note", "meta.preprocessor.string.note", "string", "comment"]
			}
		],
		"snippets": [
			{
				"language": "note",
				"path": "./snippets/note.code-snippets"
			}
		]
	}
}
