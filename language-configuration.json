{
	"comments": {
		"lineComment": "//",
		"blockComment": [ "/*", "*/"]
	},

	"brackets": [
		["[", "]"],
		["(", ")"],
		["{", "}"]
	],

	"autoClosingPairs": [
		{ "open": "[", "close": "]" },
		{ "open": "<", "close": ">" },
		{ "open": "(", "close": ")" },
		{ "open": "{", "close": "}" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] }
	],

	"surroundingPairs": [
		["[", "]"],
		["<", ">"],
		["(", ")"],
		["{", "}"],
		["\"", "\""]
	],

	"wordPattern": "[+\\-:*;§@!|%~/#<>\\[]|[A-Za-zÀ-ÿ0-9']+",
	"folding": {
		"offSide": true
	},
	
	"indentationRules": {
		"increaseIndentPattern": "\\((?!.*\\))\\s*$|\\[[^\\]]*$|<[^>]*$",
		"decreaseIndentPattern": "^\\s*[)\\]]"
	}
}
